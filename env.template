# URL de HealthLog visto desde el contenedor del bridge (misma LXC 104: usa la IP, no el dominio)
HEALTHLOG_URL=http://192.168.1.211:3130

# Token de Settings -> API & Tokens -> Measurement tokens (empieza con hlk_)
HEALTHLOG_MEASUREMENT_TOKEN=

# Opcional: token de Workout tokens, solo si quieres enviar sesiones de ejercicio  (empieza con hlk_)
HEALTHLOG_WORKOUT_TOKEN=

# Clave compartida con la app HC Webhook (header X-Bridge-Key). Generar una con: openssl rand -hex 24
BRIDGE_KEY=

# DRY_RUN   true = no envía nada a HealthLog, solo muestra en el log lo que enviaría
DRY_RUN=true

# LOG_PAYLOAD   true = imprime en el log el JSON recibido de la app (contiene datos de salud)
LOG_PAYLOAD=false
